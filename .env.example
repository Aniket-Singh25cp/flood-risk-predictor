# Copy to .env (never commit .env). Real keys stay on your machine / hosting dashboard.
APP_ENV=development
# Weather provider (Open-Meteo needs no key; OpenWeatherMap does)
OPENWEATHER_API_KEY=
# Backend
DATABASE_URL=sqlite:///./floodrisk.db
ADMIN_TOKEN=change-me
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Frontend (Vite reads VITE_* variables)
VITE_API_URL=http://localhost:8000
